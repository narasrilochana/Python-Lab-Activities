
import random

while True:
    print("\n--- Dice Simulator ---")
    print("1. Roll the Dice")
    print("2. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        result = random.randint(1, 6)
        print("You rolled:", result)

    elif choice == "2":
        print("Thank you for playing!")
        break

    else:
        print("Invalid choice. Please try again.")
