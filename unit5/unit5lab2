
class Library:
    def __init__(self, books=None):
        self.books = books if books is not None else {}

    def display_books(self):
        if not self.books:
            print("No books in the library.")
            return

        print("\n--- Library Books ---")
        for title, available in self.books.items():
            if available:
                status = "Available"
            else:
                status = "Borrowed"

            print("- %s: %s" % (title, status))

    def borrow_book(self, title):
        if title not in self.books:
            print("'%s' does not exist in the library." % title)
        elif not self.books[title]:
            print("Sorry, '%s' is currently borrowed." % title)
        else:
            self.books[title] = False
            print("You have borrowed '%s'." % title)

    def return_book(self, title):
        if title not in self.books:
            print("'%s' does not belong to this library." % title)
        elif self.books[title]:
            print("'%s' was not borrowed." % title)
        else:
            self.books[title] = True
            print("You have returned '%s'. Thank you!" % title)


# Example Usage
library = Library({
    "Python Crash Course": True,
    "Clean Code": True,
    "The Pragmatic Programmer": True
})

library.display_books()
library.borrow_book("Clean Code")
library.borrow_book("Clean Code")
library.return_book("Clean Code")
library.display_books()
