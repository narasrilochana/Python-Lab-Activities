"""Lab1: Log File Reader Program
Question:
Develop a Python program to read a log file named log.txt.
The program should:
1. Open the log file in read mode.
2. Display all the contents of the file line by line.
3. Count the total number of ERROR messages in the file.
4. Display the total number of errors.
5. Handle the situation where the file does not exist."""

try:
    with open("log.txt", "r") as file:
        error_count = 0

        print("Contents of Log File:")

        for line in file:
            print(line, end="")

            if "ERROR" in line:
                error_count += 1

        print("\nTotal number of ERROR messages:", error_count)

except FileNotFoundError:
    print("Error: log.txt file does not exist.")

