#Write a Python program to check whether a given positive integer is a
Prime Number or Not a Prime Number.
num = int(input("Enter a number: "))

if num <= 1:
    print("Not a Prime Number")
else:
    prime = True

    for i in range(2, int(num**0.5) + 1):
        if num % i == 0:
            prime = False
            break

    if prime:
        print("Prime Number")
    else:
        print("Not a Prime Number")

#Write a Python program to find the factorial of a positive integer using loop.
num = int(input("Enter a number: "))

if num < 0:
    print("Factorial does not exist for negative numbers.")
elif num == 0:
    print("Factorial = 1")
else:
    fact = 1
    for i in range(1, num + 1):
        fact = fact * i
    print("Factorial =", fact)

#Write a Python program to print the first n terms of the Fibonacci series.
n = int(input("Enter number of terms: "))

if n <= 0:
    print("Please enter a positive integer.")
elif n == 1:
    print(0)
else:
    a, b = 0, 1
    print(a, end=" ")
    print(b, end=" ")

    for i in range(3, n + 1):
        c = a + b
        print(c, end=" ")
        a = b
        b = c
    print()  # Print newline at the end

#Write a Python program to print the first n terms of the Fibonacci series
Using Recursion.
def fibonacci(n):
    """Return the nth Fibonacci number recursively."""
    if n <= 0:
        return 0
    elif n == 1:
        return 1
    else:
        return fibonacci(n - 1) + fibonacci(n - 2)

def print_fibonacci_series(n):
    """Print the first n terms of the Fibonacci series."""
    if n <= 0:
        print("Please enter a positive integer.")
        return
    
    print(f"Fibonacci series (first {n} terms):")
    for i in range(n):
        print(fibonacci(i), end=" ")
    print()
